# BLK Sponsor Outreach — Environment Variables
# Copy this file to .env and fill in your values.
# .env is gitignored. Never commit a key.

# ── Drafting ─────────────────────────────────────────────────────────────────
# Used by drafts/generate.py. The model is fed alignment_hooks only and has no
# web access.
ANTHROPIC_API_KEY=

# ── Contact verification ─────────────────────────────────────────────────────
# Only the provider selected in config/settings.yaml (contacts.verification.provider)
# needs a key.
HUNTER_API_KEY=
# APOLLO_API_KEY=
# ROCKETREACH_API_KEY=

# ── Phase G dashboard / Supabase ────────────────────────────────────────────────────
# The publishable key is safe for the login page; RLS remains the authorization
# boundary. The secret key is server-only and must never be placed in public JS.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Exactly the accounts listed in public.allowed_users are permitted to sign in
# (see supabase/migrations/001_phase_g_dashboard.sql and 005_lane_switching.sql):
# jamari@blkcapitalmanagement.org, folakunmi@blkcapitalmanagement.org,
# justin@blkcapitalmanagement.org, belayneh@blkcapitalmanagement.org.
# Keep Supabase public email signup disabled in the project Auth settings.

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Reuses the resume book's OAuth client. Leave these unset to use the paths in
# config/settings.yaml (send.auth), which already point at the resume book's
# credentials.json and this project's own token cache.
# GOOGLE_CREDENTIALS_FILE=../resume-book-builder/credentials.json
# GOOGLE_TOKEN_FILE=config/gmail_token.json
