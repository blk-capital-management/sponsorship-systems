# BLK Resume Book Builder — Environment Variables
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# ── Google OAuth (default auth mode) ─────────────────────────────────────────
# Path to the OAuth client secrets JSON downloaded from Google Cloud Console.
GOOGLE_CREDENTIALS_FILE=credentials.json

# Path where the OAuth token will be cached after first login.
# Delete this file to force a new login.
GOOGLE_TOKEN_FILE=token.json

# ── Google Service Account (optional, for automation) ────────────────────────
# Path to the service account key JSON (only needed if auth.mode = service_account
# in config/settings.yaml).
# GOOGLE_SERVICE_ACCOUNT_FILE=service_account_key.json

# ── iLovePDF API (optional, Stage 5 future backend) ──────────────────────────
# Only needed if compression.backend = ilovepdf in config/settings.yaml.
# ILOVEPDF_PUBLIC_KEY=
# ILOVEPDF_SECRET_KEY=
